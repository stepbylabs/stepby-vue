# 强制 pnpm 使用项目本地 store/cache，避免解析到其他项目的 store（含沙箱冲突）
store-dir=.pnpm-store
cache-dir=.pnpm-cache
virtual-store-dir=node_modules/.pnpm

# 工具链版本必须真校验：package.json engines 写 node>=22.13（pnpm 11 依赖 node:sqlite），
# 不开 engine-strict 时老 node 只会抛一句看不懂的 ERR_UNKNOWN_BUILTIN_MODULE，
# 开了就直接 fail-fast 说明是 node 版本不对。
engine-strict=true
