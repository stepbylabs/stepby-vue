# 页面标题
VITE_APP_TITLE = Stepby管理系统

# Bundle 体积分析档：`pnpm build:analyze`（= `vite build --mode analyze`）读取本文件。
# 除最后一行外**逐字对齐 .env.production** —— 体积分析的前提是"被测产物 == 上线产物"，
# 换了 base/压缩档/ENV 口径，treemap 里的数字与真实生产包不可比。
VITE_APP_ENV = 'production'

# Stepby管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
# 与生产同档：visualizer 的 gzipSize/brotliSize 列就是按这一档的真实压缩结果算的
VITE_BUILD_COMPRESS = gzip,brotli

# 打开 rollup-plugin-visualizer（唯一判据：vite/plugins/index.ts 里
# `if (viteEnv.VITE_ANALYZE === 'true')`）⇒ 构建旁路产出 dist/stats.html
# （treemap：模块体积占比 / gzip / brotli / 依赖树）。正常构建不开此档，产物零影响。
VITE_ANALYZE = true

# Service Worker 运行时缓存档（b115）：off | network-first
# off（默认，关闭态即安全态）：SW 只缓存公共静态目录（/static、/assets、/pwa）；
#   API 响应与受鉴权的 /uploads/** 预览图一概不进缓存，失败走页面已有的可见失败态。
# network-first（弱网演示档，显式开启才生效）：仅 GET、仅 200、TTL 60 秒、会话切换即清；
#   该档显式覆盖服务端对 API 声明的 Cache-Control: no-store。
VITE_PWA_API_CACHE = 'off'
