# 页面标题
VITE_APP_TITLE = Stepby管理系统

# 生产环境配置
VITE_APP_ENV = 'production'

# Stepby管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 是否在打包时开启压缩，支持 gzip 和 brotli
# BUILD-006：同时启用 brotli（压缩率高于 gzip，现代浏览器均支持）
# 部署侧 Nginx 需配置 brotli_static on 或 brotli on + brotli_types
VITE_BUILD_COMPRESS = gzip,brotli
