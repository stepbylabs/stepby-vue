{
  "name": "yebot-ui",
  "version": "3.9.2",
  "description": "Yebot管理系统",
  "author": "Yebot",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build:stage": "vite build --mode staging",
    "build:embedded": "vite build --mode embedded",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,mjs,cjs,css,scss,json,md}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/bmate/yebot-ui.git"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@formkit/auto-animate": "^0.10.0",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/prismjs": "^1.26.6",
    "@vueup/vue-quill": "1.5.5",
    "@vueuse/core": "14.3.0",
    "@vueuse/motion": "^3.0.3",
    "axios": "1.18.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.12",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "file-saver": "2.0.5",
    "fuse.js": "7.5.0",
    "html2pdf.js": "^0.14.0",
    "js-beautify": "2.0.3",
    "js-cookie": "3.0.8",
    "libphonenumber-js": "^1.13.10",
    "md-editor-v3": "^6.5.4",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "nprogress": "0.2.0",
    "pinia": "4.0.2",
    "prismjs": "^1.30.0",
    "vue": "3.5.40",
    "vue-cropper": "1.1.4",
    "vue-i18n": "^10.0.8",
    "vue-router": "5.2.0",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass-embedded": "1.100.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "8.1.5",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-svg-icons": "2.0.1",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.7"
  },
  "resolutions": {
    "quill": "2.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  }
}
