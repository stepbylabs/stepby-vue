# 页面标题
VITE_APP_TITLE = Stepby管理系统

# 「后端同源直出（rust-embed）」档的构建配置：`pnpm build:embedded`（mode=embedded）读取本文件。
# 为什么 VITE_APP_ENV 仍写 production：EnvBanner 只在非 production 时渲染（
# src/components/EnvBanner/index.vue），这一档是**真正的生产部署形态**，不能带调试横幅；
# vite.config.ts 也按 VITE_APP_ENV 决定压缩/drop_console 口径。
VITE_APP_ENV = 'production'

# 基址留空：这一档的 dist 被后端 rust-embed 打进二进制、由 Router::merge 挂在**根路径**
# （router/mod.rs 同时 nest 了 /prod-api、/dev-api、/stage-api，但嵌入形态浏览器直达后端，
# 请求本来就是 /getInfo 这样的根路径）。写成 '/prod-api' 会多一层前缀（后端也认，但
# 反向代理去前缀的那套部署不适用）。见 stepby-vue/tests/e2e/RUN-RECIPE.md §3.8。
VITE_APP_BASE_API = ''

# 与 .env.production 同档压缩：嵌入进二进制的产物同样要小
VITE_BUILD_COMPRESS = gzip,brotli
