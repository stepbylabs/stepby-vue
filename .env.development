# 页面标题
VITE_APP_TITLE = Stepby管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# Stepby管理系统/开发环境（请求基址前缀，由 vite 代理转发到后端，不要改成完整 URL）
VITE_APP_BASE_API = '/dev-api'

# 后端代理目标地址：开发/预览服务器将 /dev-api、/prod-api、/stage-api、/ws 代理到此地址
# 后端不在本机 8080 时，改为对应地址（如 http://192.168.1.10:8080）
VITE_PROXY_TARGET = http://localhost:8080

# Service Worker 运行时缓存档（b115）：off | network-first
# off（默认，关闭态即安全态）：SW 只缓存公共静态目录（/static、/assets、/pwa）；
#   API 响应与受鉴权的 /uploads/** 预览图一概不进缓存，失败走页面已有的可见失败态。
# network-first（弱网演示档，显式开启才生效）：仅 GET、仅 200、TTL 60 秒、会话切换即清；
#   该档显式覆盖服务端对 API 声明的 Cache-Control: no-store。
VITE_PWA_API_CACHE = 'off'
