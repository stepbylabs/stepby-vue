# 页面标题
VITE_APP_TITLE = Stepby管理系统

# 开发环境配置
VITE_APP_ENV = 'development'

# Stepby管理系统/开发环境（请求基址前缀，由 vite 代理转发到后端，不要改成完整 URL）
VITE_APP_BASE_API = '/dev-api'

# 后端代理目标地址：开发/预览服务器将 /dev-api、/prod-api、/stage-api、/ws 代理到此地址
# 后端不在本机 8080 时，改为对应地址（如 http://192.168.1.10:8080）
VITE_PROXY_TARGET = http://localhost:8080
