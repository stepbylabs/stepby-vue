.DS_Store
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
**/*.log
# run-detached.mjs 的旁证（监管 PID / 子进程 PID / 退出码）：与日志同性质——一轮一份、
# 只作本轮取证用，进仓就成了下一批的假基线（实测 `*.log` 一条规则盖不住这三个后缀）
**/*.log.pid
**/*.log.child.pid
**/*.log.exit

tests/**/coverage/
/coverage/
tests/e2e/reports

# e2e 运行产物（失败截图 + JSON 报告），不入库
/screenshots/
selenium-debug.log

# e2e 轮次批跑运行时产物（进度 JSON + runner 自身日志），不入库
tests/e2e/_rounds2026*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.local

# 环境变量：**只有 `.env` 本身与 `.local` 本机覆盖项**属于私密/临时文件，模式文件一律入库。
#
# 为什么改成"先全放行、再精确忽略"（批七十六）：原先是"忽略 `.env.*` + 逐个 `!` 放行"的
# **枚举白名单**，同一个失误犯了两次——批七十五 .env.embedded 从未进库（embedded 档构建出
# 的 bundle 里 VITE_APP_BASE_API=undefined），批七十六又发现 .env.analyze 同样漏网
# （`pnpm build:analyze` 因 VITE_ANALYZE 取不到值而根本不开 visualizer）。
# 每加一个 `--mode <x>` 档都要记得回来补一行 `!`，这种判据必然再漏。
#
# gitignore 语义是"最后匹配的规则生效"，所以下面 `!.env.*` 必须先写、三条忽略项后置：
# `.env` / `.env.local` / `.env.*.local` 依旧不入库，而任何新增的 `.env.<模式>` 自动入库。
!.env.*
.env
.env.local
.env.*.local

# 自动生成的类型声明
auto-imports.d.ts
components.d.ts

# 本地 agent 工作目录与临时提交信息（不应入库）
.workbuddy/
commit_msg.txt
_cm.txt

# 沙箱隔离的本地 pnpm store/cache（避免与全局 store 冲突；不应入库）
.pnpm-store/
.pnpm-store-local/
.pnpm-local-store/
.pnpm-cache-local/

# Playwright 浏览器缓存目录（不应入库）
tests/e2e/.browsers/

# e2e 批跑器运行状态产物
tests/e2e/_rounds*_done.json
tsconfig.tsbuildinfo

# e2e 归档与覆盖率产物（批五十：可再生数据不入库）
tests/e2e/_archive/
coverage/
# 根级一次性会话脚本（_fix_menus.py / _gc_priv6.py / _probe.mjs 这类）——
# 只服务于当次会话，且历史上出过"硬编码远端 token 被留在脚本里"的情况，一律不入库。
/_*.py
/_*.ps1
/_*.mjs
/_*.cjs
/_*.sh

# 一次性改造/取证脚本（批七十六 R-8 口径，与 stepby-axum/.gitignore 同源判据）
# tests/e2e 下的 diag-/probe-/_* 是历轮浏览器探针：留在原地可复查，但不进版本库视野，
# 免得下一次 `git add .` 把 78 个中转脚本一起提交（本批已发生过一次，见台账 §9.7）。
/patch_*.py
/clean_f*.py
/scan_*.py
/commit_msg*.txt
/_m.txt
/scripts/_tmp_*.py
/tests/e2e/_*.py
/tests/e2e/_*.cjs
/tests/e2e/_tmp/
/tests/e2e/diag-*.mjs
/tests/e2e/probe-*.mjs

# 知识图谱生成物（与根仓同口径：graphify update 每轮重扫）
graphify-out/
